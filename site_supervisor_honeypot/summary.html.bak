<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Site Supervisor</title>
<link rel="icon" type="image/x-icon" href="./images/favicon-DPD4Tvk1.ico"/>
<style>
:root{--bg:#0f1419;--panel:#1a2332;--border:#2a3a4e;--text:#e8eef5;--muted:#8aa0b8;
--accent:#00a3e0;--ok:#3dd68c;--warn:#f5a623;--crit:#e85d5d;--input:#0d1218;--nav:#0a0e14}
*{box-sizing:border-box}body{margin:0;font-family:"Segoe UI",system-ui,sans-serif;background:var(--bg);color:var(--text)}
.topnav{display:flex;align-items:center;gap:8px;padding:8px 16px;background:var(--nav);border-bottom:1px solid var(--border)}
.topnav .icon{width:32px;height:32px;border-radius:4px;background:#152030;border:1px solid var(--border);
display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--muted);cursor:default}
.topnav .icon.active{border-color:var(--accent);color:var(--accent)}
.topnav .title{margin-left:8px;font-size:15px;font-weight:600}
.topnav .right{margin-left:auto;font-size:12px;color:var(--muted);text-align:right}
.topnav .right strong{color:var(--accent)}
.banner{background:#13202e;padding:8px 20px;font-size:12px;color:var(--muted);border-bottom:1px solid var(--border);
display:flex;gap:20px;flex-wrap:wrap}.banner b{color:var(--text)}
main{padding:20px;max-width:1200px;margin:0 auto}
h2{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin:0 0 12px}
.tabs{display:flex;gap:4px;margin-bottom:14px}
.tabs button{background:transparent;border:1px solid var(--border);color:var(--muted);padding:6px 14px;
border-radius:4px 4px 0 0;cursor:pointer;font-size:12px}
.tabs button.active{background:var(--panel);color:var(--accent);border-bottom-color:var(--panel)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px}
.tile{background:var(--panel);border:1px solid var(--border);border-radius:8px;padding:14px 16px}
.tile:hover{border-color:var(--accent)}.tile .name{font-size:12px;color:var(--muted);margin-bottom:4px;
white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tile .label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.tile .temp{font-size:28px;font-weight:600;font-variant-numeric:tabular-nums}
.tile .temp .eu{font-size:13px;color:var(--muted);margin-left:4px}
.tile .sp{font-size:12px;color:var(--muted);margin-top:8px;display:flex;align-items:center;gap:6px}
.tile .sp input{width:70px;background:var(--input);border:1px solid var(--border);color:var(--text);
border-radius:4px;padding:3px 6px;font-size:12px}
.tile .sp button{background:var(--accent);border:none;color:#fff;border-radius:4px;padding:4px 10px;
font-size:11px;cursor:pointer}.tile.hot .temp{color:var(--crit)}.tile.cold .temp{color:var(--accent)}.tile.ok .temp{color:var(--ok)}
.alarms{margin-top:28px}table{width:100%;border-collapse:collapse;font-size:13px}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--border)}
th{color:var(--muted);font-weight:500;font-size:11px;text-transform:uppercase}
.tag{display:inline-block;padding:2px 8px;border-radius:3px;font-size:11px;background:#3a2030;color:var(--crit)}
footer{margin:32px 0 16px;font-size:11px;color:var(--muted);text-align:center}
#status.live{color:var(--ok)}
</style>
</head>
<body>
<!-- Top icons per Quick Setup Guide: Main Menu, Home, Back, Control Inventory, Schedules/Events -->
<div class="topnav">
  <div class="icon" title="Main Menu">☰</div>
  <div class="icon active" title="Home">⌂</div>
  <div class="icon" title="Back">←</div>
  <div class="icon" title="Control Inventory">▦</div>
  <div class="icon" title="Schedules / Events">⏱</div>
  <div class="title">System Summary</div>
  <div class="right">
    <div><strong id="sitename">Riverside Market</strong></div>
    <div>E3 CXe · fw <span id="fw">2.30F01</span> · <span id="status">connecting…</span></div>
  </div>
</div>
<div class="banner">
  <span>Site Name: <b id="sitename2">Riverside Market</b></span>
  <span>Unit: <b id="unitname">E3 Unit01</b></span>
  <span>Platform: <b>E3</b> · Model: <b>CXe</b></span>
  <span>Desc: <b>C-Store Expansion (CXe)</b></span>
  <span>Session: <b id="sid">—</b></span>
</div>
<main>
  <div class="tabs"><button class="active">Status</button><button disabled>Refrigeration</button><button disabled>HVAC</button></div>
  <h2>Application Tiles · Case Temp / Setpoint</h2>
  <div class="grid" id="tiles"></div>
  <div class="alarms">
    <h2>Active Alarms</h2>
    <table>
      <thead><tr><th>Category</th><th>Originator</th><th>Message</th><th>Report</th><th>Limit</th></tr></thead>
      <tbody id="alarms"></tbody>
    </table>
  </div>
</main>
<footer>Site Supervisor · Riverside Market · Engineering units °F · P/N 026-1803 terminology</footer>
<script>
const API="/cgi-bin/mgw.cgi"; let SID="", POINTS=[];
async function rpc(method, params={}){
  const payload={jsonrpc:"2.0",method,params:Object.assign(SID?{sid:SID}:{},params),id:String(Date.now())};
  const body=new URLSearchParams(); body.set("m",JSON.stringify(payload)); if(SID) body.set("sid",SID);
  const r=await fetch(API,{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body});
  const j=await r.json();
  if(j.result&&j.result.sid){SID=j.result.sid;document.getElementById("sid").textContent=SID.slice(0,8)+"…";}
  return j.result;
}
function renderTiles(points){
  POINTS=points; const el=document.getElementById("tiles");
  el.innerHTML=points.map(p=>{
    const d=p.value-p.setpoint; const cls=Math.abs(d)<1.5?"ok":(d>0?"hot":"cold");
    return `<div class="tile ${cls}" data-pid="${p.pid}">
      <div class="name">${p.name}</div>
      <div class="label">${p.point_label||"Case Temp"}</div>
      <div class="temp">${Number(p.value).toFixed(1)}<span class="eu">${p.eu||"°F"}</span></div>
      <div class="sp">Setpoint <input type="number" step="0.1" value="${Number(p.setpoint).toFixed(1)}" id="sp-${p.pid}"/>
      <button onclick="setSP('${p.pid}')">Apply</button></div></div>`;
  }).join("");
}
async function setSP(pid){
  const val=parseFloat(document.getElementById("sp-"+pid).value);
  await rpc("SetPointValues",{points:[{pid,setpoint:val}]});
}
async function refreshAlarms(){
  const r=await rpc("GetAlarms",{}); const alarms=(r&&r.alarms)||[];
  document.getElementById("alarms").innerHTML=alarms.map(a=>`<tr>
    <td><span class="tag">${a.category}</span></td><td>${a.originator}</td><td>${a.messagekey}</td>
    <td>${parseFloat(a.reportvalue).toFixed(2)} °F</td><td>${parseFloat(a.limitvalue).toFixed(2)} °F</td>
  </tr>`).join("")||`<tr><td colspan="5" style="color:var(--muted)">No active alarms</td></tr>`;
}
async function boot(){
  // No Login — open System Summary
  const sess=await rpc("GetSessionID",{}); if(sess&&sess.sid) SID=sess.sid;
  const info=await rpc("GetSystemInformation",{});
  if(info){
    document.getElementById("sitename").textContent=info.SiteName||"Riverside Market";
    document.getElementById("sitename2").textContent=info.SiteName||"Riverside Market";
    document.getElementById("unitname").textContent=info.unitname||"E3 Unit01";
    document.getElementById("fw").textContent=info.unitversion||"2.30F01";
  }
  const pts=await rpc("GetPointValues",{}); if(pts&&pts.points) renderTiles(pts.points);
  await refreshAlarms();
  document.getElementById("status").textContent="live"; document.getElementById("status").className="live";
  const proto=location.protocol==="https:"?"wss":"ws";
  const ws=new WebSocket(`${proto}://${location.host}/stream?sid=${encodeURIComponent(SID)}`);
  ws.onmessage=ev=>{try{const m=JSON.parse(ev.data); if(m.points) renderTiles(m.points);}catch(e){}};
  ws.onclose=()=>{document.getElementById("status").textContent="reconnecting…"; document.getElementById("status").className=""; setTimeout(boot,3000);};
  setInterval(refreshAlarms,15000);
}
boot();
</script>
</body>
</html>
