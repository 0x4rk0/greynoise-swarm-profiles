        ("Base Log", "Log Group", "Refrigeration"),
        ("System Sett", "SystemSettings", "System"),
        ("COMPort", "SerialPortConfig", "System"),
        ("E3 Unit01", "AreaCtrl", "System"),
        ("GLOBAL DATA", "Global Data", "System"),
        ("Firmware Update", "Firmware Update", "System"),
        ("AlarmComm_001", "AlarmCommunications", "Other"),
        ("CONDENSER A", "Condenser", "Refrigeration"),
        ("-23 SUCTION EN", "Enhanced Suction", "Refrigeration"),
    ]:
        apps.append({
            "appname": name, "appstatus": "addok", "apptype": apptype,
            "category": cat, "categorydef": cat, "categoryname": cat,
            "commissionable": 0, "device": False, "iid": _iid(), "name": name,
        })
    for i in range(1, 5):
        apps.append({
            "DevAddr": str(i), "Route": "IONet-01", "appname": f"16AI_{i:03d}",
            "appstatus": "addok", "apptype": "16 Analog Inputs", "category": "System",
            "categorydef": "System", "categoryname": "System", "commissionable": 1,
            "device": True, "devicetype": "IONet", "iid": _iid(), "name": f"16AI_{i:03d}",
        })
        apps.append({
            "DevAddr": str(i), "Route": "IONet-01", "appname": f"8RO_{i:03d}",
            "appstatus": "addok", "apptype": "8 Relay Outputs", "category": "System",
            "categorydef": "System", "categoryname": "System", "commissionable": 1,
            "device": True, "devicetype": "IONet", "iid": _iid(), "name": f"8RO_{i:03d}",
        })
