}


def _iid() -> str:
    return str(random.randint(100_000_000, 4_294_967_295))


def _now() -> int:
    return int(time.time())


class Point:
    __slots__ = ("pid", "name", "apptype", "eu", "value", "setpoint", "noise", "rate",
                 "point_label", "base_value", "easing")

    def __init__(self, name, apptype, eu, value, setpoint, noise=0.15, rate=0.04, point_label="Case Temp"):
        self.pid = _iid()
        self.name = name
        self.apptype = apptype
        self.eu = eu
        self.value = float(value)
        self.base_value = float(value)  # stable resting value near setpoint
        self.setpoint = float(setpoint)
        self.noise = noise
        self.rate = rate  # gentle ease after setpoint change
        self.point_label = point_label
        self.easing = False  # True until value settles near new setpoint

    def tick(self):
        # After a setpoint change, ease gently toward new setpoint then stabilize
        if self.easing:
            gap = self.setpoint - self.value
            if abs(gap) < 0.25:
                self.value = self.setpoint + random.uniform(-self.noise, self.noise)
                self.base_value = self.setpoint
                self.easing = False
            else:
                self.value += gap * self.rate + random.uniform(-0.05, 0.05)
        else:
            # Tiny jitter around stable base (±noise, typically 0.1-0.3 °F)
            self.value = self.base_value + random.uniform(-self.noise, self.noise)

    def as_dict(self):
        return {
            "pid": self.pid,
            "name": self.name,
            "apptype": self.apptype,
            "eu": self.eu,
            "value": round(self.value, 2),
            "setpoint": round(self.setpoint, 2),
            "point_label": self.point_label,
            "display": f"{self.value:.1f} {self.eu}",
        }


# Realistic stable refrigeration values (tiny jitter only)
