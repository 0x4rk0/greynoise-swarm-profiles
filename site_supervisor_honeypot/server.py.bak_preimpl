def handle_SetPointValues(params, sid, src_ip, username):
    """Accept writes WITHOUT login — log heavily. Temps ease toward new SP."""
    sid = ensure_session(sid, src_ip)
    p = params or {}
    items = p if isinstance(p, list) else (p.get("points") if isinstance(p.get("points"), list) else [p])
    changes = []
    for item in items:
        if not isinstance(item, dict):
            continue
        pid = str(item.get("pid") or item.get("iid") or item.get("id") or "")
        name = str(item.get("name") or "")
        pt = POINT_BY_PID.get(pid) or POINT_BY_NAME.get(name)
        if not pt:
            continue
        new_sp = item.get("setpoint", item.get("value", item.get("val")))
        if new_sp is None:
            continue
        try:
            new_sp_f = float(new_sp)
        except (TypeError, ValueError):
            continue
        old = pt.setpoint
        pt.setpoint = new_sp_f
        pt.easing = True  # gently drift value toward new SP
        if "force_value" in item:
            try:
                pt.value = float(item["force_value"])
                pt.base_value = pt.value
                pt.easing = False
            except (TypeError, ValueError):
                pass
        changes.append({"pid": pt.pid, "name": pt.name, "old_setpoint": old,
                        "new_setpoint": new_sp_f, "current_value": round(pt.value, 2)})
        log_event(
            "setpoint_change", src_ip, "SetPointValues",
            {"pid": pt.pid, "name": pt.name, "old": old, "new": new_sp_f},
            sid, username or SESSIONS.get(sid, {}).get("username", ""),
            extra={"old_setpoint": old, "new_setpoint": new_sp_f, "current_value": round(pt.value, 2)},
        )
    if not changes:
        log_event("setpoint_change", src_ip, "SetPointValues", p, sid, username, extra={"note": "no_matching_points"})
        return {"success": False, "error": "No matching points", "accepted": []}
    try:
        asyncio.get_running_loop().create_task(broadcast_points())
    except RuntimeError:
        pass
    return {"success": True, "accepted": changes}


# ---------------- Menu / view stubs (synthetic) ----------------
BOOT_TS = _now() - 86400 * 37 - 4211
ALARM_STATE: dict[str, dict[str, Any]] = {}

def _circuit_state(pt: Point) -> str:
    # Deterministic rotating state based on time + pid for believable defrost cycles
    cycle = 6 * 3600 if pt.setpoint > 0 else 8 * 3600
    phase = (int(time.time()) + int(pt.pid[-3:] or "0")) % cycle
    if phase < 1500:
        return "Defrost"
    if phase < 1800:
        return "Drip"
    return "Refrigeration"


def handle_GetDefrostSummary(params, sid, src_ip, username):
    sid = ensure_session(sid, src_ip)
    log_event("recon", src_ip, "GetDefrostSummary", params, sid, username)
    rows = []
    t = _now()
    for p in POINTS:
        if p.apptype != "StdCircuit":
            continue
        cycle = 6 * 3600 if p.setpoint > 0 else 8 * 3600
        phase = (t + int(p.pid[-3:] or "0")) % cycle
        next_in = cycle - phase
        rows.append({
            "pid": p.pid, "name": p.name, "apptype": p.apptype,
            "temp": round(p.value, 2), "setpoint": round(p.setpoint, 2), "eu": p.eu,
            "state": _circuit_state(p),
            "defrost_type": "Off Time" if p.setpoint > 0 else "Electric",
            "next_defrost": t + next_in,
            "next_defrost_in_sec": next_in,
            "duration_min": 25 if p.setpoint > 0 else 40,
        })
    return {"circuits": rows}


def handle_GetNetworkSummary(params, sid, src_ip, username):
    sid = ensure_session(sid, src_ip)
    log_event("recon", src_ip, "GetNetworkSummary", params, sid, username)
    # SPA reads i.devices and derives thisSS = device with status "This Unit"
    # (Ce.THIS_SUPVR). ControllerType 107 = E3. address must equal unitNumber (1)
    # so isLocalUnit() is true and point data is fetched for the summary tiles.
    local_unit = {
        "iid": "1",
        "appname": SITE["unitname"],
        "name": SITE["unitname"],
        "unitname": SITE["unitname"],
        "unitnumber": "1",
        "address": "1",
        "status": "This Unit",
        "ControllerType": "107",
        "isaggregator": "0",
        "isannunciator": "0",
        "maintenance": False,
        "port": "",
        "version": SITE["unitversion"],
        "model": SITE["unitmodel"],
        "ipaddress": "192.168.10.50",
        "macaddress": "00:1A:2B:3C:4D:5E",
    }
    return {"devices": [local_unit]}


