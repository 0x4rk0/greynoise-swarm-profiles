def _point_desc(iid, pid, pt):
    """Build a GetPointsDescription point entry the SPA\'s Ye.update() accepts."""
    cfg = SUMMARY_PT.get(pt.apptype) if pt else None
    if cfg and pid == cfg["pid"]:
        return {
            "pid": pid, "name": cfg["name"], "group": "Overview", "grpseq": "1",
            "subgrpseq": "1", "class": cfg["cls"], "funct": "", "desc": cfg["name"],
            "dtype": cfg["dtype"], "prec": cfg["prec"], "attr": [],
            "val": str(_wire_val(pt)),
        }
    if pid == "AppName":
        return {"pid": "AppName", "name": "Name", "group": "", "class": "", "funct": "",
                "dtype": "str", "attr": [], "val": (pt.name if pt else str(iid))}
    return {"pid": pid, "name": pid, "group": "", "class": "", "funct": "",
            "dtype": "float", "prec": 1, "attr": [], "val": "0"}


def _point_value_record(ptr):
    """Build a GetPointValues/RealTime point record (val on wire in device unit)."""
    iid, _, pid = str(ptr).partition(":")
    pt = POINT_BY_PID.get(iid)
    if pid == "AppName":
        return {"ptr": ptr, "val": (pt.name if pt else iid), "status": "0",
                "dtype": "str", "adv": []}
    if pt:
        cfg = SUMMARY_PT.get(pt.apptype)
        return {
            "ptr": ptr, "val": str(_wire_val(pt)), "status": "0",
            "class": (cfg["cls"] if cfg else ""),
            "dtype": (cfg["dtype"] if cfg else "float"),
            "prec": (cfg["prec"] if cfg else 1),
            "adv": [],
        }
    return {"ptr": ptr, "val": "0", "status": "0", "dtype": "float", "adv": []}


def _request_ptrs(params):
    p = params or {}
    pts = p.get("points") if isinstance(p, dict) else (p if isinstance(p, list) else [])
    out = []
    for item in (pts or []):
        if isinstance(item, dict) and item.get("ptr"):
            out.append(str(item["ptr"]))
        elif isinstance(item, str):
            out.append(item)
    return out


