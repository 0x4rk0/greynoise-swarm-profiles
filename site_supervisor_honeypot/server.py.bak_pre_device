def handle_SetPointValues(params, sid, src_ip, username):
    """SPA write: params {points:[{ptr:"iid:pid", val:"<device unit>"}]}.
    For class \'temp\' the SPA sends Celsius; convert to degF, ease the value toward it,
    log, and fire ALERT_WEBHOOK_URL. Response {points:[{ptr,val}]}; no err == success."""
    sid = ensure_session(sid, src_ip)
    p = params or {}
    items = p.get("points") if isinstance(p, dict) and isinstance(p.get("points"), list) else (
        p if isinstance(p, list) else [p])
    results = []
    changed = False
    for item in items:
        if not isinstance(item, dict):
            continue
        ptr = item.get("ptr") or ""
        if ptr:
            iid, _, pid = str(ptr).partition(":")
        else:
            iid = str(item.get("pid") or item.get("iid") or "")
            pid = ""
            ptr = f"{iid}:{pid}" if iid else ""
        pt = POINT_BY_PID.get(iid) or POINT_BY_NAME.get(str(item.get("name") or ""))
        raw = item.get("val", item.get("value", item.get("setpoint")))
        if raw is None:
            results.append({"ptr": ptr, "err": "No value"})
            continue
        try:
            raw_f = float(raw)
        except (TypeError, ValueError):
            results.append({"ptr": ptr, "err": "Invalid value"})
            continue
        if not pt:
            # Still log the attempt; report not found so SPA surfaces it.
            log_event("setpoint_change", src_ip, "SetPointValues",
                      {"ptr": ptr, "val": raw}, sid, username, extra={"note": "unknown_point"})
            results.append({"ptr": ptr, "err": "Point not found"})
            continue
        cfg = SUMMARY_PT.get(pt.apptype)
        # Incoming value is in device unit: Celsius for temp-class, raw otherwise.
        new_f = c2f(raw_f) if (cfg and cfg["temp"]) else raw_f
        old_f = pt.setpoint
        pt.setpoint = new_f
        pt.easing = True  # gently drift current value toward the new setpoint
        changed = True
        results.append({"ptr": ptr, "val": str(round(raw_f, 3))})
        log_event(
            "setpoint_change", src_ip, "SetPointValues",
            {"ptr": ptr, "name": pt.name, "old": round(old_f, 2), "new": round(new_f, 2)},
            sid, username or SESSIONS.get(sid, {}).get("username", ""),
            extra={"name": pt.name, "old_setpoint": round(old_f, 2),
                   "new_setpoint": round(new_f, 2), "current_value": round(pt.value, 2),
                   "unit": "degF"},
        )
    if changed:
        try:
            asyncio.get_running_loop().create_task(broadcast_points())
        except RuntimeError:
            pass
    if not results:
        return {"points": [], "success": False}
    return {"points": results}


