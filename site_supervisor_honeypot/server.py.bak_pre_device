def handle_Login(params, sid, src_ip, username):
    """SPA Login RPC. Real UI auto-calls Login with key=system.default, value="" (empty).
    Accepts key/value (SPA) or username/password. Empty password for system.default is OK.
    Response shape matches SPA: permissions + newsid.
    """
    sid = ensure_session(sid, src_ip)
    p = params or {}
    user = str(p.get("key") or p.get("username") or p.get("user") or "")
    pw = str(p.get("value") if "value" in p else (p.get("password") or p.get("pass") or ""))
    # system.default with empty password is the SPA's default open session
    ok = (
        (user == "system.default" and pw == "")
        or (user, pw) in CREDS
        or (user.lower() == "admin" and pw in ("", "Admin", "admin", "pass"))
    )
    if ok:
        SESSIONS[sid]["username"] = user or "system.default"
        log_event("login_success", src_ip, "Login", {"username": user}, sid, user)
        return {
            "success": True,
            "permissions": ["admin", "write", "commission", "view"],
            "newsid": sid,
            "sid": sid,
            "role": "admin",
            "username": user or "system.default",
            "privileges": ["admin", "write", "commission"],
        }
    log_event("login_fail", src_ip, "Login", {"username": user}, sid, user)
    return {"success": False, "error": "Invalid username or password", "permissions": []}


